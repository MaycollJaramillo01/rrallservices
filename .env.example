# Entrega de los formularios propios (/api/leads: /contacto y home).
# GHL_PRIVATE_INTEGRATION crea el contacto y la oportunidad en GoHighLevel.
# Solo servidor: nunca con prefijo NEXT_PUBLIC_.
GHL_PRIVATE_INTEGRATION=
# Sin GHL_PRIVATE_INTEGRATION ni RESEND_API_KEY el lead solo se escribe en los logs del servidor.
RESEND_API_KEY=
LEAD_FROM_EMAIL=leads@rrallservices.com
LEAD_TO_EMAIL=rrallservicves@gmail.com
